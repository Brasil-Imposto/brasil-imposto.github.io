{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://brasil-imposto.github.io/schemas/state.schema.json",
 "title": "State",
 "type": "object",
 "additionalProperties": false,
 "required": ["type", "id", "name", "ibge_code", "population", "series"],
 "properties": {
  "type": {"const": "state"},
  "id": {"type": "string", "pattern": "^[A-Z]{2}$"},
  "name": {"type": "string"},
  "ibge_code": {"type": "string", "pattern": "^[0-9]{2}$"},
  "population": {"$ref": "common.schema.json#/$defs/yearly_series"},
  "series": {
   "type": "object",
   "additionalProperties": false,
   "required": ["federal_revenue", "transfers", "bolsa_familia", "bpc", "inss"],
   "properties": {
    "federal_revenue": {"$ref": "common.schema.json#/$defs/monthly_series"},
    "transfers": {"$ref": "common.schema.json#/$defs/monthly_series"},
    "bolsa_familia": {"$ref": "common.schema.json#/$defs/monthly_series"},
    "bpc": {"$ref": "common.schema.json#/$defs/monthly_series"},
    "inss": {"$ref": "common.schema.json#/$defs/monthly_series"}
   }
  }
 }
}
