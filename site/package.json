{
  "name": "brasil-imposto-site",
  "private": true,
  "type": "module",
  "description": "The Brasil-Imposto site in Astro (phase B0 skeleton; the published site is still the previews until phase B5).",
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "entities": "cd .. && uv run --locked python pipelines/export/build_entities.py",
    "types": "node scripts/gen-types.mjs",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "build": "astro build"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
